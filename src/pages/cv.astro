---
import Layout from '../layouts/Layout.astro'
---

<Layout title="CV | Alex Paz" description="Curriculum vitae of Alex Paz, Software Developer.">
    <div class="min-h-screen bg-[#09090b] flex flex-col">
        <!-- Top bar -->
        <div
            class="sticky top-0 z-10 bg-[#09090b]/80 backdrop-blur-xl border-b border-zinc-900 px-6 py-3 flex items-center justify-between"
        >
            <a
                href="/"
                class="flex items-center gap-2 text-zinc-400 hover:text-zinc-100 transition-colors text-sm"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <path d="m15 18-6-6 6-6"></path>
                </svg>
                Back to portfolio
            </a>
            <a
                href="/cv_esp.pdf"
                download="CV_Alex_Paz.pdf"
                class="flex items-center gap-2 px-4 py-1.5 bg-sky-600 hover:bg-sky-500 text-white rounded-lg text-sm font-medium transition-colors"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="15"
                    height="15"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="7 10 12 15 17 10"></polyline>
                    <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                Download PDF
            </a>
        </div>

        <!-- PDF viewer -->
        <div class="flex-1 p-4 md:p-8">
            <iframe
                src="/cv_esp.pdf"
                class="w-full h-full min-h-[85vh] rounded-xl border border-zinc-800"
                title="Alex Paz - CV"
            >
                <p class="text-zinc-400 text-center py-12"> Your browser doesn't support embedded
                PDFs. <a href="/cv_esp.pdf" class="text-sky-400 underline">Download it here.</a> </p>
            </iframe>
        </div>
    </div>
</Layout>
