---
const frontend = ['HTML / CSS', 'JavaScript', 'TypeScript', 'Angular', 'Vue', 'React', 'Svelte']
const backend = [
    'Node.js',
    'Express',
    'NestJS',
    'C#',
    'EF Core',
    'REST APIs',
    'MySQL',
    'MongoDB',
    'Redis',
]
const devops = ['Git', 'Azure', 'Vercel', 'CI/CD', 'Jest', 'E2E Testing']
---

<section id="skills" class="py-24 border-t border-zinc-900 scroll-mt-14">
    <div class="max-w-5xl mx-auto px-6">
        <p class="text-sky-400 text-sm font-medium uppercase tracking-widest mb-4">Skills</p>
        <h2 class="text-3xl sm:text-4xl font-bold text-zinc-100 mb-12">Tech Stack</h2>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-10">
            <div>
                <h3 class="text-xs font-semibold uppercase tracking-widest text-zinc-500 mb-5">
                    Frontend
                </h3>
                <div class="flex flex-wrap gap-2">
                    {
                        frontend.map((skill) => (
                            <span class="px-3 py-1.5 bg-zinc-900 border border-zinc-800 text-zinc-300 rounded-lg text-sm font-medium">
                                {skill}
                            </span>
                        ))
                    }
                </div>
            </div>

            <div>
                <h3 class="text-xs font-semibold uppercase tracking-widest text-zinc-500 mb-5">
                    Backend
                </h3>
                <div class="flex flex-wrap gap-2">
                    {
                        backend.map((skill) => (
                            <span class="px-3 py-1.5 bg-sky-600/10 border border-sky-500/20 text-sky-300 rounded-lg text-sm font-medium">
                                {skill}
                            </span>
                        ))
                    }
                </div>
            </div>

            <div>
                <h3 class="text-xs font-semibold uppercase tracking-widest text-zinc-500 mb-5">
                    DevOps & Testing
                </h3>
                <div class="flex flex-wrap gap-2">
                    {
                        devops.map((skill) => (
                            <span class="px-3 py-1.5 bg-zinc-900 border border-zinc-800 text-zinc-300 rounded-lg text-sm font-medium">
                                {skill}
                            </span>
                        ))
                    }
                </div>
            </div>
        </div>
    </div>
</section>
