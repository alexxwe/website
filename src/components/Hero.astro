            <!-- Role -->
            <p class="text-2xl sm:text-3xl font-semibold text-sky-400 mb-4">Software Developer</p>

            <!-- Location -->
            <div class="flex items-center gap-1.5 text-zinc-500 text-sm mb-6">
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
